{application, hera,
 [{description, "A framework for dynamic measurements."},
  {vsn, "1.0.0"},
  {registered, [hera_data, hera_com, hera_measure_sup]},
  {mod, {hera, []}},
  {applications,
   [kernel,
    stdlib,
    grisp,
    grisp_updater_grisp2
   ]},
  {env, [{log_data, false}, {start_com, true}, {uwb_arx2init, false}]},
  {modules, [hera, hera_sup, hera_data, hera_com,
    hera_measure_sup, hera_measure, hera_nav, nav_calib, hera_uwb, uwb_twr,
    kalman, mat, oldmat, blasmat, blasws, kfblas, blas, chain, timeEst,
    kalman_bench, bench_runner,
    hera_fusion, sim_replay, sim_measure, sim_fusion, sim_live]},
  {licenses, ["Apache 2.0"]},
  {links, []}
 ]}.
